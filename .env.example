# Database: paste the connection string from Supabase or Neon.
# Leave it empty to use a local SQLite file while developing.
# Supabase: Project Settings -> Database -> Connection string (URI)
# Neon: Dashboard -> Connect -> connection string (it ends with ?sslmode=require)
DATABASE_URL=

# Random secret used to sign the login session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailgun -> Sending -> Domains (sandbox domain works) and Settings -> API keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=sandboxXXXX.mailgun.org
MAILGUN_FROM=Bootcamp Shop <postmaster@sandboxXXXX.mailgun.org>
# Use https://api.eu.mailgun.net if your Mailgun domain is in the EU region
MAILGUN_API_BASE=https://api.mailgun.net

# Public URL of the site (change after deploying)
BASE_URL=http://localhost:8000
